#version 460

#include "include/shadows.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform FrameData
{
    mat4 viewProjection;
    mat4 inverseViewProjection;
    mat4 unjitteredViewProjection;
    mat4 previousViewProjection;
    mat4 previousUnjitteredViewProjection;
    vec4 cameraPositionExposure;
    vec4 directionalDirectionIntensity;
    vec4 directionalColor;
    vec4 pointPositionIntensity;
    vec4 pointColorRange;
    vec4 environmentParameters;
    uvec4 cullingParameters;
    uvec4 visibilityMask;
    vec4 temporalJitter;
    uvec4 temporalFlags;
    vec4 shadowSceneCenterRadius;
    vec4 shadowCascadeCenterRadius1;
    vec4 shadowCascadeCenterRadius2;
    vec4 shadowCascadeSplits;
    vec4 shadowCascadeDepthRadii;
    vec4 previousCameraPosition;
} frameData;

layout(push_constant) uniform ShadowPushConstants
{
    uint cascadeIndex;
} shadowPush;

struct InstanceRecord
{
    vec4 centerRadius;
    uvec4 meshMaterial;
    uvec4 visibilityLayer;
};
layout(std430, set = 0, binding = 1) readonly buffer Instances
{
    InstanceRecord instances[];
};

struct MeshletWorkRecord
{
    uint indexCount;
    uint firstIndex;
    int vertexOffset;
    uint instanceIndex;
    vec2 projectedDiameterRange;
    uint lodIndex;
    uint reserved;
};
layout(std430, set = 0, binding = 2) readonly buffer MeshletWork
{
    MeshletWorkRecord workItems[];
};
layout(std430, set = 0, binding = 3) writeonly buffer VisibleInstances
{
    uint visibleInstanceIndices[];
};

struct DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, set = 0, binding = 4) writeonly buffer IndirectCommands
{
    DrawIndexedIndirectCommand drawCommands[];
};
layout(std430, set = 0, binding = 5) buffer DrawCount
{
    uint drawCount;
};

float cameraProjectedDiameterPixels(vec3 center, float radius)
{
    vec4 centerClip = frameData.unjitteredViewProjection * vec4(center, 1.0);
    if (centerClip.w <= 0.0001) {
        return 0.0;
    }
    return abs(frameData.unjitteredViewProjection[1][1]) * radius *
           float(frameData.cullingParameters.w) / centerClip.w;
}

void main()
{
    uint workIndex = gl_GlobalInvocationID.x;
    if (workIndex >= workItems.length()) {
        return;
    }
    MeshletWorkRecord work = workItems[workIndex];
    if (work.instanceIndex >= instances.length()) {
        return;
    }
    InstanceRecord instance = instances[work.instanceIndex];
    uvec2 commonLayers = instance.visibilityLayer.xy & frameData.visibilityMask.xy;
    float projectedDiameter =
        cameraProjectedDiameterPixels(instance.centerRadius.xyz, instance.centerRadius.w);
    bool selectedLod = projectedDiameter >= work.projectedDiameterRange.x &&
                       projectedDiameter < work.projectedDiameterRange.y;
    vec4 cascadeCenterRadius = directionalShadowCascadeCenterRadius(
        shadowPush.cascadeIndex, frameData.shadowSceneCenterRadius,
        frameData.shadowCascadeCenterRadius1, frameData.shadowCascadeCenterRadius2);
    float cascadeDepthRadius = directionalShadowCascadeDepthRadius(
        shadowPush.cascadeIndex, frameData.shadowCascadeDepthRadii);
    vec3 shadowCenter = directionalShadowCoordinate(
        instance.centerRadius.xyz, frameData.directionalDirectionIntensity.xyz,
        cascadeCenterRadius, cascadeDepthRadius);
    vec3 normalizedRadius =
        instance.centerRadius.w /
        max(vec3(cascadeCenterRadius.w, cascadeCenterRadius.w, cascadeDepthRadius) * 2.0,
            vec3(1.0e-5));
    bool insideShadow = all(greaterThanEqual(shadowCenter, -normalizedRadius)) &&
                        all(lessThanEqual(shadowCenter, vec3(1.0) + normalizedRadius));
    if (!any(notEqual(commonLayers, uvec2(0u))) || !selectedLod || !insideShadow) {
        return;
    }
    uint outputIndex = atomicAdd(drawCount, 1u);
    if (outputIndex >= drawCommands.length() || outputIndex >= visibleInstanceIndices.length()) {
        return;
    }
    visibleInstanceIndices[outputIndex] = work.instanceIndex;
    drawCommands[outputIndex] = DrawIndexedIndirectCommand(
        work.indexCount, 1u, work.firstIndex, work.vertexOffset, outputIndex);
}
