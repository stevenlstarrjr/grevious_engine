#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D denoisedDiffuse;
layout(set = 0, binding = 1) uniform sampler2D denoisedSpecular;
layout(set = 0, binding = 2) uniform sampler2D nrdMaterial;
layout(set = 0, binding = 3) uniform sampler2D motionDepthAov;
layout(set = 0, binding = 4) uniform sampler2D rawRadiance;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D outputRadiance;

void main()
{
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputRadiance);
    if (any(greaterThanEqual(coordinate, size))) {
        return;
    }
    vec3 diffuse = max(texelFetch(denoisedDiffuse, coordinate, 0).rgb, vec3(0.0));
    vec3 specular = max(texelFetch(denoisedSpecular, coordinate, 0).rgb, vec3(0.0));
    vec4 material = texelFetch(nrdMaterial, coordinate, 0);
    vec4 motionDepth = texelFetch(motionDepthAov, coordinate, 0);
    vec3 baseColor = clamp(material.rgb, vec3(0.0), vec3(1.0));
    float metallic = clamp(material.a, 0.0, 1.0);
    vec3 diffuseFactor = max(baseColor * (1.0 - metallic), vec3(0.04));
    vec3 specularFactor = max(mix(vec3(0.04), baseColor, metallic), vec3(0.04));
    vec3 radiance = motionDepth.w > 0.0
        ? diffuse * diffuseFactor + specular * specularFactor
        : max(texelFetch(rawRadiance, coordinate, 0).rgb, vec3(0.0));
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    imageStore(outputRadiance, coordinate, vec4(radiance, 1.0));
}
