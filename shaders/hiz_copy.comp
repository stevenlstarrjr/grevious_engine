#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D sourceDepth;
layout(r32f, set = 0, binding = 1) uniform writeonly image2D destinationDepth;

void main()
{
    ivec2 destinationCoordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(destinationCoordinate, imageSize(destinationDepth)))) {
        return;
    }
    imageStore(destinationDepth, destinationCoordinate,
               vec4(texelFetch(sourceDepth, destinationCoordinate, 0).r));
}
