#version 460
#extension GL_EXT_ray_tracing : require

#include "include/ibl.glsl"
#include "include/path_trace.glsl"

layout(set = 0, binding = 9) uniform sampler2D environmentMap;
#define BRUNETON_TRANSMITTANCE_BINDING 24
#define BRUNETON_SCATTERING_BINDING 25
#define BRUNETON_IRRADIANCE_BINDING 26
#define GENESIS_CLOUD_BASE_NOISE_BINDING 27
#define GENESIS_CLOUD_DETAIL_NOISE_BINDING 28
#include "include/genesis_atmosphere.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneTlas;
layout(set = 0, binding = 1, rgba32f) uniform image2D accumulationImage;
layout(set = 0, binding = 2) uniform FrameData
{
    mat4 viewProjection;
    mat4 inverseViewProjection;
    mat4 unjitteredViewProjection;
    mat4 previousViewProjection;
    mat4 previousUnjitteredViewProjection;
    vec4 cameraPositionExposure;
    vec4 directionalDirectionIntensity;
    vec4 directionalColor;
    vec4 pointPositionIntensity;
    vec4 pointColorRange;
    vec4 environmentParameters;
    uvec4 cullingParameters;
    uvec4 visibilityMask;
    vec4 temporalJitter;
    uvec4 temporalFlags;
    vec4 shadowSceneCenterRadius;
    vec4 shadowCascadeCenterRadius1;
    vec4 shadowCascadeCenterRadius2;
    vec4 shadowCascadeSplits;
    vec4 shadowCascadeDepthRadii;
    vec4 previousCameraPosition;
    vec4 atmosphereCamera;
    vec4 atmosphereSunDirection;
    vec4 cloudLayerParameters;
    vec4 cloudWeatherParameters;
} frameData;

layout(push_constant) uniform PathTracePushConstants
{
    uint sampleIndex;
    uint sampleInFrame;
    uint samplesThisFrame;
    uint fixedPrimarySample;
} controls;

layout(location = 0) rayPayloadEXT RadiancePayload payload;

vec3 cameraRayDirection(vec2 ndc)
{
    vec4 world = frameData.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    return normalize(world.xyz / world.w - frameData.cameraPositionExposure.xyz);
}

vec3 compositePrimaryCloudSegment(vec3 surfaceRadiance, vec3 genesisDirection,
                                  float hitDistanceMeters)
{
    if (hitDistanceMeters <= 0.0 ||
        frameData.atmosphereSunDirection.w < 0.5 ||
        frameData.cloudWeatherParameters.w < 0.5 ||
        frameData.cloudLayerParameters.z <= 0.0 ||
        frameData.cloudLayerParameters.w <= 0.0) {
        return surfaceRadiance;
    }

    vec3 viewDirection = normalize(genesisToBrunetonDirection(genesisDirection));
    float cloudStart;
    float cloudEnd;
    if (!genesisCloudRayInterval(frameData.atmosphereCamera.xyz, viewDirection,
                                 frameData.cloudLayerParameters.x,
                                 frameData.cloudLayerParameters.y,
                                 cloudStart, cloudEnd)) {
        return surfaceRadiance;
    }

    float hitDistanceKm = hitDistanceMeters * 0.001;
    if (hitDistanceKm <= cloudStart + 1.0e-4) {
        return surfaceRadiance;
    }

    // The dynamic atmosphere cache contains the full cloud-shell integral in
    // RGB and its Beer transmittance in alpha. If geometry terminates inside
    // the shell, exponentiating alpha by the traversed fraction gives the
    // corresponding bounded segment without a second per-pixel volume march.
    float segmentFraction = clamp(
        (min(hitDistanceKm, cloudEnd) - cloudStart) /
            max(cloudEnd - cloudStart, 1.0e-4),
        0.0, 1.0);
    vec4 cachedCloudSky = textureLod(
        environmentMap, directionToDualParaboloidUv(genesisDirection), 0.0);
    float fullTransmittance = clamp(cachedCloudSky.a, 0.0, 1.0);
    float segmentTransmittance = pow(max(fullTransmittance, 1.0e-4),
                                     segmentFraction);

    vec3 clearSky = genesisAtmosphereRadiance(
        genesisDirection, frameData.atmosphereCamera.xyz,
        frameData.atmosphereSunDirection.xyz, false);
    vec3 fullCloudRadiance = max(
        cachedCloudSky.rgb - clearSky * fullTransmittance, vec3(0.0));
    float fullOpacity = 1.0 - fullTransmittance;
    float segmentOpacity = 1.0 - segmentTransmittance;
    vec3 segmentCloudRadiance = fullCloudRadiance *
        (fullOpacity > 1.0e-4 ? segmentOpacity / fullOpacity : 0.0);

    if (frameData.cloudWeatherParameters.w > 1.5 &&
        frameData.cloudWeatherParameters.w < 2.5) {
        return vec3(segmentOpacity);
    }
    return max(segmentCloudRadiance +
                   surfaceRadiance * segmentTransmittance,
               vec3(0.0));
}

void main()
{
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uvec2 extent = gl_LaunchSizeEXT.xy;
    uint linearPixel = pixel.y * extent.x + pixel.x;
    uint state = pathTraceHash(linearPixel ^ pathTraceHash(controls.sampleIndex));
    // Temporal path tracing keeps primary geometry at a fixed pixel center.
    // Shifting either the projection or this sample would make accumulated
    // radiance disagree with the current first-hit AOVs and cause shimmer.
    // Native/spatial rendering retains stochastic progressive antialiasing.
    vec2 jitter = controls.fixedPrimarySample != 0u
        ? vec2(0.5)
        : vec2(pathTraceRandom(state), pathTraceRandom(state));
    vec2 ndc = ((vec2(pixel) + jitter) / vec2(extent)) * 2.0 - 1.0;
    vec3 origin = frameData.cameraPositionExposure.xyz;
    vec2 ndcPixelSize = 2.0 / vec2(extent);
    vec2 rayNdc = ndc;
    if (controls.fixedPrimarySample == 2u &&
        frameData.atmosphereSunDirection.w > 0.5) {
        // RR traces finite geometry through the jittered projection, while an
        // atmosphere miss is reconstructed at the stable pixel center. Rays
        // grazing the procedural ground could consequently alternate between
        // a bright wet-ground hit and a sky miss. Use the same stable ray only
        // inside the two-pixel horizon footprint; ordinary geometry keeps its
        // normal jitter and antialiasing everywhere else.
        vec2 jitterNdc = 2.0 * frameData.temporalJitter.xy / vec2(extent);
        vec2 stableNdc = ndc + jitterNdc;
        vec3 stableDirection = cameraRayDirection(stableNdc);
        vec3 stableDirectionY = cameraRayDirection(
            stableNdc + vec2(0.0, ndcPixelSize.y));
        float verticalRayFootprint = length(stableDirection - stableDirectionY);
        if (abs(stableDirection.y) < 2.0 * verticalRayFootprint) {
            rayNdc = stableNdc;
        }
    }
    vec3 direction = cameraRayDirection(rayNdc);
    vec3 directionX = cameraRayDirection(rayNdc + vec2(ndcPixelSize.x, 0.0));
    vec3 directionY = cameraRayDirection(rayNdc + vec2(0.0, ndcPixelSize.y));

    payload.radiance = vec3(0.0);
    payload.pathThroughput = vec3(1.0);
    payload.depth = 0u;
    payload.seed = state;
    payload.coneWidth = 0.0;
    // Chord length is a stable small-angle approximation that avoids acos
    // losing the subpixel footprint when the two normalized rays nearly agree.
    payload.coneSpread = max(length(direction - directionX),
                             length(direction - directionY));
    payload.bouncePdf = 0.0;
    payload.firstLobeHitDistance = 0.0;
    payload.primaryHitDistance = 0.0;
    float sceneScale = max(frameData.shadowCascadeDepthRadii.w, 1.0);
    traceRayEXT(sceneTlas, gl_RayFlagsNoneEXT, 0xff, 0, 2, 0,
                origin, sceneScale * 1.0e-5, direction, 1.0e27, 0);

    vec3 surfaceRadiance = payload.radiance;
    if (payload.primaryHitDistance > 0.0 &&
        frameData.atmosphereSunDirection.w > 0.5) {
        vec3 groundFogDirection = genesisGroundFogSourceDirection(
            direction, frameData.atmosphereCamera.xyz);
        // Fog represents many unresolved aerosol scattering events, so its
        // source must be a low-frequency sky irradiance rather than one sharp
        // environment-cache texel. At a grazing angle the latter stretches
        // cloud/cache detail into repeated strips along the horizon.
        vec3 groundFogUp = normalize(vec3(
            frameData.atmosphereCamera.x,
            frameData.atmosphereCamera.z,
            -frameData.atmosphereCamera.y));
        vec3 groundFogRight = cross(groundFogDirection, groundFogUp);
        if (length(groundFogRight) <= 1.0e-6) {
            groundFogRight = vec3(1.0, 0.0, 0.0);
        } else {
            groundFogRight = normalize(groundFogRight);
        }
        const float fogHorizontalFilter = 0.035;
        const float fogVerticalFilter = 0.012;
        vec3 groundFogSourceRadiance = vec3(0.0);
        float groundFogSourceWeight = 0.0;
        for (int filterY = -1; filterY <= 1; ++filterY) {
            for (int filterX = -1; filterX <= 1; ++filterX) {
                float weightX = filterX == 0 ? 2.0 : 1.0;
                float weightY = filterY == 0 ? 2.0 : 1.0;
                float weight = weightX * weightY;
                vec3 filteredDirection = normalize(
                    groundFogDirection +
                    groundFogRight * (float(filterX) * fogHorizontalFilter) +
                    groundFogUp * (float(filterY) * fogVerticalFilter));
                groundFogSourceRadiance += textureLod(
                    environmentMap,
                    directionToDualParaboloidUv(filteredDirection), 0.0).rgb *
                    weight;
                groundFogSourceWeight += weight;
            }
        }
        groundFogSourceRadiance /= max(groundFogSourceWeight, 1.0);
        surfaceRadiance = genesisApplyAerialPerspective(
            surfaceRadiance, direction, payload.primaryHitDistance,
            frameData.atmosphereCamera.xyz,
            frameData.atmosphereSunDirection.xyz,
            groundFogSourceRadiance);
    }
    vec3 sampleColor = compositePrimaryCloudSegment(
        surfaceRadiance, direction, payload.primaryHitDistance);
    if (any(isnan(sampleColor)) || any(isinf(sampleColor))) {
        sampleColor = vec3(0.0);
    }
    vec3 accumulated = sampleColor;
    // fixedPrimarySample == 2 is the DLSS Ray Reconstruction mode: preserve
    // frame-varying random seeds while presenting only this frame's noisy sample.
    if (controls.fixedPrimarySample < 2u && controls.sampleIndex > 0u) {
        vec3 previous = imageLoad(accumulationImage, ivec2(pixel)).rgb;
        float count = float(controls.sampleIndex);
        // Wind-driven clouds are a continuous lighting change, not a history
        // discontinuity. Cap their accumulator to a rolling 64-frame window so
        // low-Sun diffuse lighting converges without allowing old cloud shadows
        // to dominate indefinitely. Ray Reconstruction bypasses this accumulator.
        if (frameData.cloudWeatherParameters.w > 0.5) {
            count = min(count, 63.0);
        }
        accumulated = (previous * count + sampleColor) / (count + 1.0);
    }
    imageStore(accumulationImage, ivec2(pixel), vec4(max(accumulated, vec3(0.0)), 1.0));
}
